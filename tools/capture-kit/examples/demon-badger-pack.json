{
  "name": "demon-badger-pack",
  "description": "Demon Badger V2 siege on map 04 (dusk): six free badgers (hp raised so the turrets do not kill them first) run at the middle base, spit void flames, heat up stage by stage through their own salvos and melt down in front of it, spread out by their per-body salvo pause, never on a shared schedule.",
  "viewport": { "width": 1280, "height": 720 },
  "board": { "columns": 4, "tileWidth": 480 },
  "hud": false,
  "scenario": {
    "classId": "inspector_gadachs",
    "seed": 12345,
    "player": "$player"
  },
  "times": [
    { "id": "dusk", "timeOfDay": 1170, "label": "19:30" }
  ],
  "layouts": [
    { "id": "map04", "scenario": { "mapId": "4" },
      "vars": { "player": { "gridX": 38, "gridY": 27 }, "view": { "gridX": 50, "gridY": 21 },
        "a": { "gridX": 57, "gridY": 17 }, "b": { "gridX": 59, "gridY": 18 }, "c": { "gridX": 61, "gridY": 20 },
        "d": { "gridX": 61, "gridY": 22 }, "f": { "gridX": 61, "gridY": 24 }, "g": { "gridX": 60, "gridY": 25 } } }
  ],
  "setup": [
    { "op": "camera", "at": "$view", "zoom": 1.3 },
    { "op": "settle" },
    { "op": "spawn", "kind": "demon-badger", "at": "$a", "hp": 300, "name": "a" },
    { "op": "spawn", "kind": "demon-badger", "at": "$b", "hp": 300, "name": "b" },
    { "op": "spawn", "kind": "demon-badger", "at": "$c", "hp": 300, "name": "c" },
    { "op": "spawn", "kind": "demon-badger", "at": "$d", "hp": 300, "name": "d" },
    { "op": "spawn", "kind": "demon-badger", "at": "$f", "hp": 300, "name": "f" },
    { "op": "spawn", "kind": "demon-badger", "at": "$g", "hp": 300, "name": "g" },
    { "op": "mark" }
  ],
  "shots": [
    { "id": "approach", "label": "Anlauf (+1,5 s)", "do": [{ "op": "ms", "ms": 1500 }] },
    { "id": "first-step", "label": "erste Salve: Stufe 1", "do": [
      { "op": "until", "expr": "host.enemies.some(x => x.kind === 'demon-badger' && x.heatBurst && x.heatBurst.stage >= 1)", "maxFrames": 900 },
      { "op": "step", "frames": 3 }
    ] },
    { "id": "stage3", "label": "erster Dachs auf Stufe 3", "do": [
      { "op": "until", "expr": "host.enemies.some(x => x.kind === 'demon-badger' && x.heatBurst && x.heatBurst.stage >= 3)", "maxFrames": 900 }
    ] },
    { "id": "warning", "label": "erste Kernschmelze-Warnung (+500 ms)", "do": [
      { "op": "until", "expr": "host.enemies.some(x => x.kind === 'demon-badger' && x.heatBurst && x.heatBurst.telegraphAt > 0 && host.now >= x.heatBurst.telegraphAt + 500)", "maxFrames": 900 }
    ] },
    { "id": "first", "label": "1. Kernschmelze", "do": [
      { "op": "mark" },
      { "op": "until", "expr": "host.explosionsSinceMark.filter(x => x.style === 'demon_burst').length >= 1", "maxFrames": 600 },
      { "op": "step", "frames": 12 }
    ] },
    { "id": "second", "label": "2. Kernschmelze", "do": [
      { "op": "until", "expr": "host.explosionsSinceMark.filter(x => x.style === 'demon_burst').length >= 2", "maxFrames": 600 },
      { "op": "step", "frames": 12 }
    ] },
    { "id": "rest", "label": "alle durchgeschmolzen", "do": [
      { "op": "until", "expr": "host.explosionsSinceMark.filter(x => x.style === 'demon_burst').length >= 6", "maxFrames": 1200, "optional": true },
      { "op": "step", "frames": 12 }
    ] },
    { "id": "after", "label": "danach (+1,5 s)", "do": [{ "op": "ms", "ms": 1500 }] }
  ]
}
