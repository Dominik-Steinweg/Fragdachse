{
  "name": "demon-badger-spit",
  "description": "Demon Badger void spit on map 04: a pinned badger ~150 px from the player spits short, forceful void-flame bursts (5 flames in ~0.2 s, then a pause); flames that die out leave void ground fire. The badger gets 100000 HP so nearby base turrets do not end the capture.",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "board": {
    "columns": 3,
    "tileWidth": 520
  },
  "hud": false,
  "scenario": {
    "classId": "inspector_gadachs",
    "seed": 12345,
    "player": "$player"
  },
  "times": [
    {
      "id": "day",
      "timeOfDay": 720,
      "label": "12:00"
    },
    {
      "id": "night",
      "timeOfDay": 1320,
      "label": "22:00"
    }
  ],
  "layouts": [
    {
      "id": "map04",
      "scenario": {
        "mapId": "4"
      },
      "vars": {
        "player": {
          "gridX": 38,
          "gridY": 27
        },
        "badger": {
          "gridX": 43,
          "gridY": 27
        },
        "view": {
          "gridX": 40.5,
          "gridY": 27
        }
      }
    }
  ],
  "setup": [
    {
      "op": "camera",
      "at": "$view",
      "zoom": 2
    },
    {
      "op": "settle"
    },
    {
      "op": "spawn",
      "kind": "demon-badger",
      "at": "$badger",
      "pinned": true,
      "name": "d",
      "hp": 100000
    },
    {
      "op": "js",
      "code": "const m=(ck.dev.runtime.flow??ck.dev.runtime).getCoopMissionRuntime(); const ex=m.coopDefenseEnemyAttackSystem.weaponExecution; const orig=ex.fire.bind(ex); window.__spits=0; ex.fire=(c,p)=>{const r=orig(c,p); if(r&&String(c.id).startsWith('DEMON_BADGER_VOID_SPIT')) window.__spits++; return r;};"
    },
    {
      "op": "mark"
    }
  ],
  "shots": [
    {
      "id": "s1",
      "label": "1. Flamme (+33 ms)",
      "do": [
        {
          "op": "until",
          "expr": "window.__spits >= 1",
          "maxFrames": 600
        },
        {
          "op": "step",
          "frames": 2
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Stoß"
        }
      ]
    },
    {
      "id": "s2",
      "label": "Stoß voll (+150 ms)",
      "do": [
        {
          "op": "step",
          "frames": 7
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Stoß"
        }
      ]
    },
    {
      "id": "s3",
      "label": "Stoß endet (+300 ms)",
      "do": [
        {
          "op": "step",
          "frames": 9
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Stoß"
        }
      ]
    },
    {
      "id": "ground",
      "label": "Bodenfeuer (+700 ms)",
      "do": [
        {
          "op": "ms",
          "ms": 400
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Boden"
        }
      ]
    },
    {
      "id": "s4",
      "label": "2. Stoß (+150 ms)",
      "do": [
        {
          "op": "until",
          "expr": "window.__spits >= 5",
          "maxFrames": 600
        },
        {
          "op": "step",
          "frames": 9
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Stoß"
        }
      ]
    },
    {
      "id": "ground2",
      "label": "Boden danach (+1 s)",
      "do": [
        {
          "op": "ms",
          "ms": 850
        }
      ],
      "crops": [
        {
          "of": "$view",
          "size": [
            320,
            200
          ],
          "scale": 2,
          "label": "Boden"
        }
      ]
    }
  ]
}
