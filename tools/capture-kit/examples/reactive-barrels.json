{
  "name": "reactive-barrels",
  "description": "Strategic explosive barrels on map 03 (chokepoints on the enemy routes): the three-barrel group at idle (natural, off-grid arrangement), then a pistol hit ignites a two-barrel group, the shared red danger zone announces the blast radius, explosion, chain into the neighbour and burning ground. Layouts force the rusted or toxic variant locally.",
  "viewport": { "width": 1280, "height": 720 },
  "board": { "columns": 4, "tileWidth": 420 },
  "hud": false,
  "scenario": {
    "classId": "inspector_gadachs",
    "seed": 12345,
    "weapon1": "GLOCK",
    "player": "$player"
  },
  "times": [
    { "id": "day", "timeOfDay": 720, "label": "12:00" },
    { "id": "night", "timeOfDay": 1320, "label": "22:00" }
  ],
  "layouts": [
    { "id": "rusted", "scenario": { "mapId": "3" }, "vars": { "variant": "rusted" } },
    { "id": "toxic", "scenario": { "mapId": "3" }, "vars": { "variant": "toxic" } }
  ],
  "vars": {
    "player": { "gridX": 41, "gridY": 30 },
    "group": { "gridX": 65, "gridY": 33 },
    "view": { "gridX": 45, "gridY": 30 },
    "target": { "gridX": 46.5, "gridY": 30.5 },
    "pair": { "gridX": 47, "gridY": 30.5 }
  },
  "setup": [
    { "action": "reactivePropVariant", "variant": "$variant" },
    { "op": "camera", "at": "$group", "zoom": 2 },
    { "op": "settle" }
  ],
  "shots": [
    { "id": "group-2x", "label": "Dreiergruppe, Zoom 2", "do": [],
      "crops": [{ "of": "$group", "size": [160, 130], "scale": 3, "label": "Gruppe" }] },
    { "id": "group-1x", "label": "Dreiergruppe, Spielgröße", "do": [{ "op": "camera", "at": "$group", "zoom": 1 }],
      "crops": [{ "of": "$group", "size": [100, 80], "scale": 4, "label": "1x" }] },
    { "id": "burning", "label": "Pistolentreffer: brennt", "do": [
      { "op": "camera", "at": "$target", "zoom": 1.4 },
      { "action": "fire", "slot": "weapon1" },
      { "op": "until", "expr": "window.devScenario.status().reactiveProps.some(p => p.phase === 'primed')", "maxFrames": 120 },
      { "op": "ms", "ms": 700 },
      { "op": "camera", "at": "$view", "zoom": 1.4 }
    ], "crops": [{ "of": "$pair", "size": [160, 140], "scale": 3, "label": "brennt" }] },
    { "id": "warning", "label": "Gefahrenzone (< 30 % HP)", "do": [
      { "op": "until", "expr": "window.devScenario.status().reactiveProps.some(p => p.phase === 'primed' && p.progress < 0.08)", "maxFrames": 600 }
    ], "crops": [{ "of": "$pair", "size": [360, 300], "scale": 2, "label": "Zone" }] },
    { "id": "explosion", "label": "Explosion", "do": [
      { "op": "mark" },
      { "op": "until", "expr": "host.explosionsSinceMark.length > 0", "maxFrames": 600 },
      { "op": "step", "frames": 5 }
    ] },
    { "id": "chain", "label": "Kettenreaktion", "do": [
      { "op": "until", "expr": "host.explosionsSinceMark.length > 1", "maxFrames": 240, "optional": true },
      { "op": "step", "frames": 6 }
    ] },
    { "id": "aftermath", "label": "Brennender Boden", "do": [{ "op": "ms", "ms": 1100 }] }
  ]
}
