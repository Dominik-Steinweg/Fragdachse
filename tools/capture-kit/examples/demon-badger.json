{
  "name": "demon-badger",
  "description": "Demon Badger heat cycle on map 04 (neutral grade): a pinned badger cold, half charged, tipping into void violet near full heat, its travelling red warning zone, the void burst with red sparks and burning chunks, the burning ground and the cool-down.",
  "viewport": { "width": 1280, "height": 720 },
  "board": { "columns": 4, "tileWidth": 480 },
  "hud": false,
  "scenario": {
    "classId": "inspector_gadachs",
    "seed": 12345,
    "player": "$player"
  },
  "times": [
    { "id": "day", "timeOfDay": 720, "label": "12:00" },
    { "id": "night", "timeOfDay": 1320, "label": "22:00" }
  ],
  "layouts": [
    { "id": "map04", "scenario": { "mapId": "4" },
      "vars": { "player": { "gridX": 38, "gridY": 27 }, "badger": { "gridX": 54, "gridY": 28 } } }
  ],
  "setup": [
    { "op": "camera", "at": "$badger", "zoom": 2.2 },
    { "op": "settle" },
    { "op": "spawn", "kind": "demon-badger", "at": "$badger", "pinned": true, "name": "d" },
    { "op": "mark" }
  ],
  "shots": [
    { "id": "cold", "label": "kalt", "do": [{ "op": "step", "frames": 2 }],
      "crops": [{ "of": "d", "size": [110, 110], "scale": 4, "label": "Körper" }] },
    { "id": "charge50", "label": "Hitze 50 %", "do": [
      { "op": "until", "expr": "e.d.heatBurst && (host.now - e.d.heatBurst.chargeStartAt) / (e.d.heatBurst.fullAt - e.d.heatBurst.chargeStartAt) >= 0.5", "maxFrames": 900 }
    ], "crops": [{ "of": "d", "size": [110, 110], "scale": 4, "label": "Körper" }] },
    { "id": "charge92", "label": "Hitze 92 % (kippt ins Violett)", "do": [
      { "op": "until", "expr": "e.d.heatBurst && (host.now - e.d.heatBurst.chargeStartAt) / (e.d.heatBurst.fullAt - e.d.heatBurst.chargeStartAt) >= 0.92", "maxFrames": 900 }
    ], "crops": [{ "of": "d", "size": [110, 110], "scale": 4, "label": "Körper" }] },
    { "id": "warning", "label": "Warnzone (+300 ms)", "do": [
      { "op": "camera", "at": "$badger", "zoom": 1.4 },
      { "op": "until", "expr": "e.d.heatBurst && e.d.heatBurst.telegraphAt > 0 && host.now >= e.d.heatBurst.telegraphAt + 300", "maxFrames": 900 }
    ], "crops": [{ "of": "d", "size": [360, 300], "scale": 2, "label": "Zone" }] },
    { "id": "burst", "label": "Explosion", "do": [
      { "op": "mark" },
      { "op": "until", "expr": "host.explosionsSinceMark.some(x => x.style === 'demon_burst')", "maxFrames": 300 },
      { "op": "step", "frames": 3 }
    ], "crops": [{ "of": "d", "size": [360, 300], "scale": 2, "label": "Explosion" }] },
    { "id": "sparks", "label": "Funken und Brocken (+200 ms)", "do": [{ "op": "step", "frames": 9 }],
      "crops": [{ "of": "d", "size": [400, 320], "scale": 2, "label": "Funken" }] },
    { "id": "ground", "label": "Bodenfeuer (+800 ms)", "do": [{ "op": "ms", "ms": 600 }] },
    { "id": "vent", "label": "Abklingen (+1,6 s)", "do": [{ "op": "ms", "ms": 800 }],
      "crops": [{ "of": "d", "size": [110, 110], "scale": 4, "label": "Körper" }] }
  ]
}
