{
  "name": "fragdachse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "perf:chrome": "node scripts/performance/run.mjs",
    "perf:compare": "node scripts/performance/compare.mjs",
    "build:perf-lab": "tsc && vite build --mode performance-lab",
    "ai:sync": "node scripts/sync-ai-skills.mjs",
    "assets:preview": "node scripts/asset-pipeline/preview-v2.mjs",
    "assets:library": "node scripts/asset-pipeline/index-library.mjs",
    "assets:lobby-forest": "node scripts/export-lobby-forest.mjs",
    "assets:hud-frames": "node scripts/export-hud-frames.mjs",
    "audio:convert": "node scripts/convert-audio.mjs",
    "icons:generate": "node scripts/generate-upgrade-icons.mjs",
    "icons:generate-one": "node scripts/generate-upgrade-icons.mjs --id",
    "icons:audit": "node scripts/audit-upgrade-icons.mjs",
    "sprites:held": "node scripts/generate-held-item-sprites.mjs",
    "sprites:groundcover": "node scripts/generate-ground-cover-textures.mjs",
    "sprites:rockbase": "node scripts/generate-rock-base.mjs",
    "sprites:rockmoss": "node scripts/generate-rock-moss-textures.mjs",
    "sprites:rockvegetation": "node scripts/generate-rock-vegetation-textures.mjs",
    "dev": "vite",
    "dev:browser": "vite --host 127.0.0.1 --port 8090 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --exclude build/** --exclude art/** --exclude tools/audio-studio/** --exclude tests/architecture/** --exclude tests/integration/** --exclude tests/assets/** --exclude tests/stress/** --exclude tests/balance-lab/**",
    "test:architecture": "vitest run --pool=threads --exclude build/** --exclude art/** tests/architecture",
    "test:integration": "vitest run --pool=threads --exclude build/** --exclude art/** tests/integration",
    "test:assets": "vitest run --pool=threads --exclude build/** --exclude art/** tests/assets",
    "test:stress": "vitest run --pool=threads --exclude build/** --exclude art/** tests/stress",
    "test:balance-lab": "vitest run --pool=threads --exclude build/** --exclude art/** tests/balance-lab",
    "build": "tsc && vite build",
    "nav:stress": "node scripts/navigation/run-stress.mjs",
    "build:nav-lab": "tsc && vite build --mode navigation-lab",
    "build:fog-lab": "tsc && vite build --mode fog-lab",
    "check": "npm test && npm run test:architecture && npm run build && npm run build:map-editor",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:current": "npm run build && gh-pages -d dist -e current --add",
    "map:editor": "vite --config tools/map-editor/vite.config.ts --open",
    "build:map-editor": "tsc -p tools/map-editor/tsconfig.json && vite build --config tools/map-editor/vite.config.ts",
    "build:ground-lab": "tsc && vite build --mode ground-lab",
    "sprites:ground": "node scripts/generate-grass-tiles.mjs && node scripts/generate-ground-macro.mjs && node scripts/generate-ground-cover-textures.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^24.13.6",
    "gh-pages": "^6.3.0",
    "jimp": "^1.6.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.33.5",
    "stream-json": "^3.6.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
