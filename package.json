{
  "name": "fragdachse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ai:sync": "node scripts/sync-ai-skills.mjs",
    "audio:convert": "node scripts/convert-audio.mjs",
    "icons:generate": "node scripts/generate-upgrade-icons.mjs",
    "icons:generate-one": "node scripts/generate-upgrade-icons.mjs --id",
    "sprites:held": "node scripts/generate-held-item-sprites.mjs",
    "sprites:groundcover": "node scripts/generate-ground-cover-textures.mjs",
    "sprites:rockmoss": "node scripts/generate-rock-moss-textures.mjs",
    "dev": "vite",
    "dev:browser": "vite --host 127.0.0.1 --port 8090 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "build": "tsc && vite build",
    "check": "npm test && npm run build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "jimp": "^1.6.1",
    "sharp": "^0.33.5",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
